# Obligatoires hors NODE_ENV=test
JWT_SECRET=
DATABASE_URL=postgresql://kraveo:kraveo@localhost:5433/kraveo
ADMIN_PASSCODE=
# Paiements : "simulated" = tout paiement réussit sans débiter personne (refusé si NODE_ENV=production sauf ALLOW_SIMULATED_PAYMENTS=true).
# Laisser vide / autre valeur = adaptateur Razorpay (ne gère pas le FCFA), qui exige les 3 variables suivantes.
PAYMENT_PROVIDER=simulated
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optionnelles
GOOGLE_WEB_CLIENT_ID=
PAYOUT_ENC_KEY=            # openssl rand -base64 32
FIREBASE_KEY_PATH=
CLIENT_URL=
ADMIN_URL=
PORT=5000

# Connexion client par numéro + code. console = le code s'affiche dans les logs (interdit en production).
OTP_SENDER=console
# Pour WhatsApp : OTP_SENDER=whatsapp + les 3 variables suivantes (modèle « authentification » approuvé par Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_LANG=fr

# Modular pricing (KRAVEO_SPEC_MODULES.md): shadow = compare the module pipeline with the legacy price after each order; off = disabled.
PRICING_ENGINE_MODE=shadow
